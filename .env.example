DATA_MODE=REAL
API_PORT=8000
# Leave blank for the hosted single-service build; frontend calls /api on the same origin.
VITE_API_URL=
IRRIGATION_STRESS_THRESHOLD=0.16
IRRIGATION_WATCH_THRESHOLD=0.22
DATABASE_URL=
POSTGRES_PASSWORD=
GOOGLE_EARTH_ENGINE_PROJECT=
# Local Windows example only. On Render this is /etc/secrets/earthengine-key.json
GOOGLE_APPLICATION_CREDENTIALS=C:/path/to/earth-engine-service-account.json
WEATHER_API_KEY=
GEMINI_API_KEY=
